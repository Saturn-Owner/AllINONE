{
  "name": "allinone",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "package:linux": "npm run build && python3 scripts/package-preview.py",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "npm run build && node --test tests/ui.test.mjs tests/ui.unlock.test.mjs tests/ui.productivity.test.mjs tests/ui.integrations.test.mjs tests/ui.extension.test.mjs",
    "test:ui:server": "npm run build && node --test tests/ui.server.test.mjs",
    "test:ui:drive": "npm run build && node --test tests/ui.drive.test.mjs",
    "test:server": "node --test tests/server.test.mjs tests/ai.test.mjs",
    "test:ssh": "node --test tests/ssh.smoke.test.mjs",
    "server": "node server/index.mjs",
    "server:hash-password": "node server/hash-password.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "marked": "^18.1.0",
    "ssh2": "^1.17.0"
  }
}
